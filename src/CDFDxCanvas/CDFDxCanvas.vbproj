<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <Platforms>AnyCPU;x64</Platforms>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!-- CFDCanvas 的公开属性均为运行时驱动，不参与设计器序列化 -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <AssemblyName>Moira.CDFDxCanvas</AssemblyName>
    <RootNamespace>Moira.CDFDxCanvas</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>Moira.CDFDxCanvas</PackageId>
    <Title>Moira.CDFDxCanvas - DirectX CFD Voxel Visualization WinForms Control</Title>
    <Description>
      Interactive 3D visualization WinForms control for CFD voxel simulation results produced by Moira.CFDEngine.

      Features:
      - CFDCanvas control: DirectX-accelerated (DxScene3DCanvas) point-cloud / cube rendering of voxel flow fields, with frame animation playback over the simulation time series.
      - Dataset loading: metadata.json + per-frame .vti time series (CfdDataset) with lazy loading, LRU frame cache and per-field global range statistics; VtiReader parses VTK XML ImageData (raw and zlib-compressed appended data) with multi-component field expansion (velocity, species, gene expression, ...).
      - Scalar field visualization: heatmap palettes (Jet and more), auto/manual value ranges, transparency threshold, colorbar overlay.
      - Cross-section slicing along X/Y/Z axes (3D clipping as well as 2D slice heatmap bitmaps).
      - Voxel picking: click/hover a voxel to get all field values with tooltips, field time-series extraction, and pick events for external UI integration.
      - Velocity vector arrow overlay, adjustable point/cube size, opacity and debug info (FPS / device) rendering.
    </Description>
    <Summary>
      WinForms control for interactive DirectX visualization of CFD voxel time series (.vti): heatmap point clouds, cross-section slicing, voxel picking with field tooltips and velocity arrows.
    </Summary>
    <PackageTags>CFD;Voxel;PointCloud;DirectX;WinForms;Visualization;Heatmap;VTI;VTK-XML;Volume-Rendering;Time-Series;Data-Visualization;Scientific-Computing</PackageTags>
    <ReleaseNotes>
      - CfdDataset: metadata.json + per-frame .vti loading with lazy field fetch, LRU caching and per-field global range statistics.
      - VtiSnapshotRecorder outputs now include metadata.json and can be loaded directly by this control.
      - Cross-section slicing, voxel picking with hover tooltips, velocity arrow overlay and colorbar overlay rendering.
    </ReleaseNotes>
    <Version>1.0.9769.26194</Version>
    <AssemblyVersion>1.0.9769.26194</AssemblyVersion>
    <Configurations>Debug;Release;nuget_release</Configurations>
  </PropertyGroup>

  <!--
    DemoTestForm 测试入口（临时，仅开发期使用）：
      dotnet build CDFDxCanvas.vbproj -p:EnableDemoTest=true
    默认（不定义 EnableDemoTest）时本项目仍为控件库，不影响消费方。
  -->
  <PropertyGroup Condition="'$(EnableDemoTest)' == 'true'">
    <OutputType>WinExe</OutputType>
    <UseApplicationFramework>false</UseApplicationFramework>
    <StartupObject>CDFDxCanvas.DemoTestEntry</StartupObject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../.nuget/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\cuda\ILCudaTensor\ILCudaTensor.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\cuda\ILCuda\ILCuda.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\MachineLearning\TensorFlow\TensorFlow.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\gr\Microsoft.VisualBasic.Imaging\imaging.NET5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\mime\text%html\html_netcore5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\vs_solutions\dev\VisualStudio\VisualStudio.NET5.vbproj" />
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Drawing\src\DXApi\DXApi.vbproj" />
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Drawing\src\DxCanvas\DxCanvas.vbproj" />
    <ProjectReference Include="..\CFDEngine\CFDEngine.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Service Include="{94e38dff-614b-4cbd-b67c-f211bb35ce8b}" />
  </ItemGroup>

</Project>
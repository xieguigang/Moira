<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CFDEngine</AssemblyName>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>Off</OptionStrict>
    <OptionCompare>Binary</OptionCompare>
    <OptionInfer>On</OptionInfer>
    <LangVersion>16.9</LangVersion>
    <Nullable>Disable</Nullable>
    <AssemblyTitle>Basic CFD Engine for Teaching</AssemblyTitle>
    <PackageId>Moira.CFDEngine</PackageId>
    <Title>Moira.CFDEngine - Basic CFD Engine for Teaching</Title>
    <Description>
      A basic Computational Fluid Dynamics engine implemented in VB.NET using basic math functions, designed for principle learning and teaching.

      Features:
      - Stable Fluids (Jos Stam, 1999) 3D incompressible solver on a voxel grid (semi-Lagrangian advection, implicit diffusion, pressure projection) with solid-voxel obstacle masks.
      - FermentationTank: internal closed flow driven by a rotating stirrer (stirred-tank simulation with dye tracing).
      - WindTunnel: external open flow around solid voxel models (uniform freestream inlet, zero-gradient outlet, ground wall), with turbulence metrics (max/average speed, enstrophy, wake deficit).
      - Snapshot exporters: binary VTK XML ImageData (.vti) with animation.pvd and metadata.json, legacy VTK (.vtk) and JSON frame dumps, ready for ParaView or CDFDxCanvas visualization.
      - Optional CUDA GPU acceleration (CudaTensorF, float32 NVRTC kernels for Jacobi / advection / pressure projection) with automatic CPU fallback.
    </Description>
    <PackageTags>CFD;Fluid-Dynamics;StableFluids;Navier-Stokes;Wind-Tunnel;Voxel;Simulation;CUDA;GPU;VTK;VTI;Teaching;Scientific-Computing</PackageTags>
    <!-- 注意：NuGet pack 读取的是 PackageReleaseNotes（不是 ReleaseNotes） -->
    <PackageReleaseNotes>
      - Add CUDA GPU acceleration: CudaTensorF (ITensorComputeF, float32) backend with NVRTC-compiled CFD kernels (embedded resource moira_cfd_f32.cu) for Jacobi diffusion, pressure Poisson and semi-Lagrangian advection; StableFluidsSolver.UseCudaBackend switch with automatic CPU fallback.
      - VtiSnapshotRecorder now writes metadata.json (SnapshotMetadata with grid mask, dt and frame refs) so output folders can be loaded directly by CDFDxCanvas CfdDataset.
      - SnapshotMetadata.FromField factory for non-tank simulation containers.
    </PackageReleaseNotes>
    <Platforms>AnyCPU;x64</Platforms>
    <RootNamespace>Moira.CFDEngine</RootNamespace>
    <UseApplicationFramework>True</UseApplicationFramework>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>1.0.9769.26878</Version>
    <AssemblyVersion>1.0.9769.26878</AssemblyVersion>
    <Configurations>Debug;Release;nuget_release</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <RemoveIntegerChecks>True</RemoveIntegerChecks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <RemoveIntegerChecks>True</RemoveIntegerChecks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <RemoveIntegerChecks>True</RemoveIntegerChecks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <RemoveIntegerChecks>True</RemoveIntegerChecks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../.nuget/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <Compile Remove="viz\**" />
    <EmbeddedResource Remove="test\**" />
    <EmbeddedResource Remove="viz\**" />
    <None Remove="test\**" />
    <None Remove="viz\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- CFD float32 CUDA 内核源码：嵌入程序集，运行时由 CudaTensorF.CFDKernelSource 读取 -->
    <EmbeddedResource Include="Kernels\moira_cfd_f32.cu" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="viz-default.png" />
    <None Remove="viz2.png" />
    <None Remove="viz3.png" />
    <None Remove="viz4.png" />
    <None Remove="viz5.png" />
    <None Remove="viz6.png" />
    <None Remove="viz7.png" />
    <None Remove="viz8.png" />
    <None Remove="viz9.png" />
    <None Remove="vizA.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\cuda\ILCudaTensor\ILCudaTensor.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\cuda\ILCuda\ILCuda.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\MachineLearning\TensorFlow\TensorFlow.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\vs_solutions\dev\VisualStudio\VisualStudio.NET5.vbproj" />
  </ItemGroup>

</Project>

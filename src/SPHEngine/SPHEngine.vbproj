<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Moira.SPHEngine</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <StartupObject>SPHEngine.Program</StartupObject>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <LangVersion>16.9</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <Title>SPH 3d CFD engine</Title>
    <Description>
      3D SPH (Smoothed Particle Hydrodynamics) CFD engine for fermentation broth simulation.
      Ships an optimized double-density SPH solver (cylindrical vessel boundary, rotating impeller,
      CFL sub stepping, pluggable CUDA backend) plus a stirred fermenter example that exports
      ParaView ready .vti snapshot series through the CFDEngine Snapshot module.
    </Description>
    <AssemblyName>Moira.SPHEngine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- SPH float32 CUDA 内核源码：嵌入程序集，运行时由 CudaSphBackend 读取 -->
    <EmbeddedResource Include="Kernels\moira_sph_f32.cu" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\Graph\graph-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\MachineLearning\TensorFlow\TensorFlow.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\gr\physics\physics-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\cuda\ILCuda\ILCuda.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\cuda\ILCudaTensor\ILCudaTensor.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\vs_solutions\dev\VisualStudio\VisualStudio.NET5.vbproj" />
    <ProjectReference Include="..\CFDEngine\CFDEngine.vbproj" />
  </ItemGroup>

</Project>

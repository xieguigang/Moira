<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Moira.CFDEngine</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>Moira.MeshGraph</PackageId>
    <Title>Moira.MeshGraph - GNN Surrogate Models for CFD Wind-Tunnel Simulation</Title>
    <Description>
      Graph neural network (GNN) surrogate models for the Moira CFD engine (Moira.CFDEngine), designed to replace expensive repeated CFD wind-tunnel runs with fast learned predictions.

      Features:
      - MeshGNN: message-passing graph neural network over voxel-grid graphs (nodes = fluid voxels, edges = 6-neighborhood adjacency) built from CFDEngine wind-tunnel compute spaces.
      - GnnDataset: training dataset generation from parameterized wind-tunnel simulations (geometry radius x ground clearance x freestream velocity), collecting steady-state field samples (mode A) and single-step time-evolution trajectories (mode B).
      - Surrogates: SteadyStateSurrogate (geometry + freestream to steady flow field in one forward pass) and AutoregressiveSurrogate (single-step evolution model iterated rollout).
      - MeshGNNTrainer: training pipeline with CUDA GPU backend registration (GPUTensor.CudaTensor, double stack) and automatic SIMD CPU fallback.
      - VoxelSphere / CfdGraphData: parameterized sphere obstacles and voxel-to-graph conversion helpers.
    </Description>
    <Summary>
      Train and run GNN surrogate models on voxel-grid graphs to predict CFDEngine wind-tunnel flow fields, replacing repeated CFD runs with fast neural inference.
    </Summary>
    <PackageTags>GNN;Graph-Neural-Network;CFD;Surrogate-Model;Machine-Learning;Deep-Learning;Wind-Tunnel;Voxel;Scientific-Computing</PackageTags>
    <ReleaseNotes>
      - GNN surrogate training pipeline over voxel-grid graphs with steady-state (mode A) and autoregressive time-evolution (mode B) models.
      - CUDA GPU backend support via GPUTensor.CudaTensor registration (double-precision tensor stack), automatic fallback to SIMD CPU.
    </ReleaseNotes>
    <AssemblyName>Moira.MeshGraph</AssemblyName>
    <Version>1.0.9769.26194</Version>
    <AssemblyVersion>1.0.9769.26194</AssemblyVersion>
    <Configurations>Debug;Release;nuget_release</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../.nuget/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\cuda\ILCudaTensor\ILCudaTensor.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\cuda\ILCuda\ILCuda.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\MachineLearning\GNN\GNN.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\MachineLearning\TensorFlow\TensorFlow.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\vs_solutions\dev\VisualStudio\VisualStudio.NET5.vbproj" />
    <ProjectReference Include="..\CFDEngine\CFDEngine.vbproj" />
  </ItemGroup>

</Project>
